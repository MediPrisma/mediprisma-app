# Merge into a PRIVATE .env.production.local in an isolated build checkout.
# This is incomplete by design: no real hospital address, UID or credential.
# Existing public Firebase web-app settings are still required; see .env.example.
MEDIPRISMA_DEPLOYMENT_PROFILE=hospital
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# App -> independent FHIR API. Fill the approved HTTPS origin (no path).
# If FHIR is not being configured yet, leave BOTH admission and origin blank.
NEXT_PUBLIC_CDSS_ADMISSION=firebase
NEXT_PUBLIC_CDSS_API_ORIGIN=

# App -> usage-event Collector. Origin only; runtime appends /collector/v1/events.
# Blank is allowed, but retains the existing localhost fallback; not disabled.
NEXT_PUBLIC_COLLECTOR_ORIGIN=

# App -> institution report receiver. Full HTTPS endpoint, independently set.
# Blank means institution reports are not contacted. Do not infer from Collector.
NEXT_PUBLIC_LAB_REPORT_INSTITUTION_URL=

# Private backend settings (DO NOT add here or prefix with NEXT_PUBLIC_):
# FHIR_FIREBASE_ALLOWED_UIDS, backend tokens, DB passwords, encryption/TLS keys.
# The profile checks configuration only; it does not deploy or grant access.
